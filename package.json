{
  "name": "oto-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev --turbopack",
    "build": "pnpm widgets:build && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "type-check": "node packages/plateforme/widgets/build.mjs --if-missing && tsc --noEmit",
    "check:framework": "node scripts/check-framework.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:public": "node scripts/check-public.mjs",
    "migrations:sync": "node scripts/sync-migrations.mjs",
    "widgets:build": "node packages/plateforme/widgets/build.mjs",
    "verify": "node scripts/verify.mjs check:framework,type-check,lint test && node scripts/verify-receipt.mjs write",
    "verify:cached": "node scripts/verify-receipt.mjs check || pnpm verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:cleanup": "node scripts/test-cleanup.mjs",
    "db:local": "node scripts/test-db-local.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "org:export": "node scripts/org-export.mjs",
    "org:import": "node scripts/org-import.mjs",
    "oauth:clients": "node scripts/oauth-clients.mjs",
    "auth:settings": "node scripts/supabase-auth-settings.mjs",
    "data-api:close": "node scripts/supabase-data-api.mjs",
    "platform:staff": "node scripts/platform-staff.mjs",
    "mcp:smoke": "node scripts/smoke-mcp.mjs",
    "db:types": "node scripts/db-types.mjs",
    "db:migrate": "npx supabase migration new",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset"
  },
  "dependencies": {
    "@hookform/resolvers": "^5",
    "@otomata_tech/oto_platform": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2",
    "lucide-react": "^1.7.0",
    "next": "^15",
    "next-themes": "^0.4.6",
    "oauth4webapi": "3.8.8",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2",
    "zod": "^3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "aws4fetch": "1.0.20",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "eslint-plugin-import": "^2.32.0",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "jsdom": "^26",
    "mermaid": "11.17.2",
    "postcss": "^8",
    "postgres": "3.4.9",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vitest": "^3"
  },
  "packageManager": "pnpm@12.4.1"
}
