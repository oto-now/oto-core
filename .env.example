# ============================================
# App
# ============================================
# URL publique du site (adresse commune). Lue par la santé de la cellule (`admin_cell`) et par
# l'outillage Démo ; les liens des emails (connexion, invitation, réinitialisation) reviennent, eux,
# sur l'adresse d'où on les demande (E02-S01, E09-S02), si elle sert une organisation ou est celle-ci,
# l'adresse d'entrée de l'hôte (`getRequestOrigin`) ; d'une autre adresse, aucun lien ne part.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# Supabase
# ============================================
# JB crée le projet Supabase (région Paris). Les valeurs vont dans `.env.local`, jamais
# commité ; ici, les noms seulement.

# URL de l'API du projet (Settings > API). Lue par le middleware et les clients
# `src/lib/supabase/*`. Publique : exposée au navigateur.
NEXT_PUBLIC_SUPABASE_URL=

# Clé `anon` du projet (Settings > API). Publique : elle ne donne que ce que RLS autorise.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reference ID du projet (Settings > General). Lu par `pnpm db:types` et par la garde du projet de test.
SUPABASE_PROJECT_ID=

# Reference ID du projet de TEST, jamais celui de la production. Avant toute suite, Vitest et Playwright
# refusent `SUPABASE_PROJECT_ID`, `NEXT_PUBLIC_SUPABASE_URL` (ci-dessus) ou une connexion à une base de
# Supabase (`SUPABASE_DB_URL`, `PLATFORM_DATABASE_URL`, `PLATFORM_ADMIN_DATABASE_URL`, plus bas) qui vise
# un autre projet ; une adresse du poste (`localhost`, `127.0.0.1`) passe (`testing-strategy.md § Base
# de test locale`). L'outillage d'exploitation ne la lit pas.
PLATFORM_TEST_PROJECT_ID=

# Jeton d'accès personnel de l'API de gestion (supabase.com, Account > Access Tokens). PRIVÉ, outillage
# seulement : `pnpm db:types` et `pnpm auth:settings` ; jamais lu par l'application ni par le paquet,
# jamais affiché.
SUPABASE_ACCESS_TOKEN=

# Clé secrète du projet (Settings > API Keys). Sert UNIQUEMENT à l’outillage : tests d’intégration
# (organisations jetables) et `pnpm demo:seed` ; jamais lue par l’application ni par le paquet.
SUPABASE_SECRET_KEY=

# Pas de `service_role` dans l’application ni dans le paquet (architecture §6) ; la clé secrète
# ci-dessus sert aux tests d’intégration et à l’outillage seulement.

# URL de connexion directe à la base du projet (Connect > Direct connection), rôle `postgres`,
# terminée par `?sslmode=require`. PRIVÉ : elle porte le mot de passe de la base ; jamais
# `NEXT_PUBLIC_`, jamais affichée. Tests et outillage seulement : lectures de catalogue des tests
# d'intégration (`tests/helpers/admin-sql.ts`), `supabase db push --db-url`, historique des
# migrations (`packages/plateforme/migrations/README.md`) ; jamais lue par l'application ni par le
# paquet (E01-S09).
SUPABASE_DB_URL=

# Mot de passe du rôle `platform_app`, la connexion du serveur à la base (ADR-012 § 1). Lu par
# `oto-platform db prepare` seulement, qui crée le rôle. PRIVÉ : jamais affiché ; gardé pour la
# connexion du serveur du port de base (E01-S10).
PLATFORM_APP_PASSWORD=

# Connexion du serveur à la base (E01-S10, ADR-012 § 1), rôle `platform_app`. Sur Supabase, l'URL du
# pooler en mode transaction (Connect > Transaction pooler, port 6543, utilisateur
# `platform_app.<ref du projet>`). PRIVÉ : elle porte le mot de passe de `platform_app` ; jamais
# `NEXT_PUBLIC_`, jamais affichée. Lue par `server/` seulement, dans l'environnement serveur de l'hôte ;
# TLS exigé hors de la machine locale. Exigée dès la version du paquet qui passe un premier module en SQL.
PLATFORM_DATABASE_URL=

# Connexion d'administration de la base, rôle `postgres` (Connect > Direct connection) : tests
# d'intégration portables (`tests/helpers/sql.ts`) et outillage. PRIVÉ, jamais affichée ; jamais lue
# par l'application ni par le paquet (garde `tests/unit/cle-service-hors-paquet.test.ts`).
PLATFORM_ADMIN_DATABASE_URL=

# ============================================
# Sous-domaines de la cellule (E09-S02)
# ============================================
# Rôle des quatre : cellule partagée seulement ; absentes, aucun sous-domaine n'est ajouté (une
# installation d'ERP ne les pose pas). JB pose les valeurs dans l'environnement de production du
# projet Vercel ; ici, les noms seulement. Lues à chaque création d'organisation par
# `src/lib/cellule/sous-domaines.ts`.

# Rôle : domaine de base des sous-domaines, sans point initial ; une organisation `acme` reçoit
# `acme.<domaine de base>`.
CELL_BASE_DOMAIN=

# Jeton de l'API Vercel, limité à l'équipe du projet. PRIVÉ : jamais `NEXT_PUBLIC_`, jamais affiché.
VERCEL_TOKEN=

# Identifiant (ou nom) du projet Vercel qui reçoit les sous-domaines.
VERCEL_PROJECT_ID=

# Identifiant de l'équipe Vercel du projet ; facultatif (compte personnel sans équipe).
VERCEL_TEAM_ID=

# ============================================
# Email d'invitation hors Supabase (E01-S11)
# ============================================
# Hôte à émetteur OIDC (Logto, Keycloak) : la plateforme envoie elle-même l'email d'invitation, par
# ce relais (`server/mail.ts` du paquet). Sur Supabase, Supabase l'envoie : ces deux-là ne servent pas.

# Adresse du relais SMTP, `smtp://` (port 587) ou `smtps://` (port 465), utilisateur et mot de passe
# compris. TLS exigé : en `smtp://`, l'envoi échoue si le relais ne passe pas en STARTTLS ;
# `?requireTLS=false` en fin d'adresse l'accepte sans TLS, pour un relais de développement local
# seulement. PRIVÉ : jamais `NEXT_PUBLIC_`, jamais affichée.
PLATFORM_SMTP_URL=

# Expéditeur des invitations, `Nom <adresse>`, sur un domaine dont SPF et DKIM autorisent le relais.
PLATFORM_MAIL_FROM=

# ============================================
# Compte E2E
# ============================================
# Compte des contrôles visuels et des tests E2E (Playwright) ; en mode Supabase, `pnpm demo:seed` le
# crée s'il n'existe pas et en fait l'administrateur de l'organisation Démo (en mode OIDC, aucun
# compte : la personne de `--user`, sous cet email). Jamais le compte d'un client.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# ============================================
# Émetteur des jetons (E01-S11)
# ============================================
# Absentes : Supabase Auth du projet ci-dessus, l'émetteur par défaut. Posées : un émetteur OpenID
# Connect (Logto, Keycloak), un seul par hôte ; le paquet lit ses clés par sa découverte et
# l'annonce aux assistants comme serveur d'autorisation. Publiques (les métadonnées de l'hôte les
# servent), lues côté serveur à chaque vérification.

# Adresse exacte de l'émetteur, telle qu'il l'écrit dans `iss` (barre finale comprise ou non), en
# `https` (`http` sur la machine locale seulement) : `https://<logto>/oidc`,
# `https://<keycloak>/realms/<realm>`.
PLATFORM_OIDC_ISSUER=

# Audience que chaque jeton doit porter dans `aud`, exigée avec l'émetteur : la ressource d'API
# réglée chez lui, l'adresse du MCP (`https://<hôte>/api/mcp`), que le client web demande. Sur
# `/api/mcp` et `/api/mcp-admin`, la ressource annoncée pour l'adresse appelée est admise aussi
# (`https://<adresse>/api/mcp`, `https://<adresse>/api/mcp-admin`), chacune déclarée chez l'émetteur.
PLATFORM_OIDC_AUDIENCE=

# Client web confidentiel de l'hôte chez l'émetteur (E01-S11 partie b) : la connexion aux écrans passe
# par `/auth/oidc/login`. À déclarer chez l'émetteur, pour chaque adresse de l'hôte : l'adresse de
# rappel `https://<hôte>/auth/oidc/callback` (exacte chez Logto) et l'adresse après déconnexion
# `https://<hôte>/login`. Lues côté serveur, exigées avec l'émetteur.
PLATFORM_OIDC_CLIENT_ID=

# Secret de ce client. PRIVÉ : jamais `NEXT_PUBLIC_`, jamais affiché.
PLATFORM_OIDC_CLIENT_SECRET=

# Clé du cookie de session chiffré de l'hôte (AES-GCM), 32 caractères au moins, tirée au hasard
# (`openssl rand -base64 32`). PRIVÉ : jamais `NEXT_PUBLIC_`, jamais affichée ; la changer ferme toutes
# les sessions ouvertes.
PLATFORM_SESSION_SECRET=

# ============================================
# Fichiers joints (E10-S02, ADR-016)
# ============================================
# Stockage d'objets compatible S3 (AWS S3, Object Storage de Scaleway, MinIO, Supabase Storage par son
# point d'accès S3) : les cinq, ou aucun. Absentes, les fichiers sont désactivés (aucun dépôt proposé,
# l'API refuse par `not_enabled`), tout le reste fonctionne. Bucket privé, CORS réglé pour l'origine de
# l'hôte (README du paquet). Lues côté serveur seulement (`server/files/store.ts`).

# Point d'accès S3, sans le bucket : `https://s3.fr-par.scw.cloud`,
# `https://<ref>.supabase.co/storage/v1/s3`.
PLATFORM_STORAGE_ENDPOINT=

# Nom du bucket privé.
PLATFORM_STORAGE_BUCKET=

# Région du point d'accès (`fr-par`, `eu-west-3`) ; celle du projet pour Supabase.
PLATFORM_STORAGE_REGION=

# Clés d'accès S3 limitées au bucket, jamais la clé `service_role`. PRIVÉ : jamais `NEXT_PUBLIC_`,
# jamais affichées.
PLATFORM_STORAGE_ACCESS_KEY_ID=
PLATFORM_STORAGE_SECRET_ACCESS_KEY=

# ============================================
# Widgets dans la conversation (story widgets-dans-la-conversation)
# ============================================
# `on` : le widget routeur sur `call` et `read` (méta, resources `ui://`, vue des résultats), pour le banc
# des hosts ; absente ou autre valeur, le MCP reste en texte seul. Lue par `src/app/api/mcp/route.ts`.
PLATFORM_MCP_WIDGETS=

# ============================================
# Coffre des connecteurs réels (prise des connecteurs)
# ============================================
# Clé du coffre du paquet : chiffre le secret d'un compte réel de connecteur (AES-256-GCM, données associées =
# l'id du compte), 32 octets en base64 (`openssl rand -base64 32`). PRIVÉ : jamais `NEXT_PUBLIC_`, jamais
# affichée ; la même dans l'environnement serveur de l'hôte et pour `oto-platform accounts secret`. Lue à l'usage
# seulement (poser un secret, appeler un connecteur réel) : absente, l'hôte démarre, et ces gestes échouent en la
# nommant. La changer rend illisibles les secrets déjà posés : les reposer.
PLATFORM_VAULT_KEY=
