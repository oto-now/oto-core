          ],
          "type": "string",
        },
        "ops": {
          "description": "Operations on sections addressed by title, applied in order; the first that fails refuses them all (default: none). Block operations address a block by its reference instead.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "after": {
                "description": "add_section only: title of the section to insert after (default: at the end).",
