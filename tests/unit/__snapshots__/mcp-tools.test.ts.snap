          "type": "string",
        },
        "cursor": {
          "description": "Cursor given by a previous result cut at 45,000 characters, to read what follows (default: from the start).",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "draft": {
          "description": "true: read the pending draft instead of the published revision (default false).",
          "type": "boolean",
        },
        "file": {
          "description": "Id of a file (html, md, txt, csv, json, or a format the host reads), from its link /f/<id>, to read its text alone: attached to the page of path, or, without path, any file you can open, your transit files included; a long file comes as an outline of its parts, read one with section (default: the whole page).",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "outline": {
          "description": "true: only the section titles with their sizes (default false).",
          "type": "boolean",
        },
        "path": {
          "description": "Path of a page, procedure or table (e.g. ventes/relance_devis), journal, or a function name (e.g. table.rows); leave it out with file to read a file by its id.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "refs": {
          "description": "true: each block comes with its reference, e.g. <!-- ref: 3f9a2c1b -->, for the block operations of write (default false).",
          "type": "boolean",
        },
        "section": {
          "description": "Title of one section to read, e.g. "Étapes" (default: the whole page, or its outline if long). With file: one part of the file, or "*" for its whole text.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "since_revision": {
          "description": "Only what changed after this revision, e.g. 3 (default: the current content).",
