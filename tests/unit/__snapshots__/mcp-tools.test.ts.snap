                "type": "string",
              },
              "section": {
                "description": "Title of the section it applies to, e.g. "Étapes". Section operations, and move_block (to the end of that section). Titles are unique in a page: add_section refuses one that exists, and a title held by two headings is refused with the refs of their blocks. replace_text without section: the whole page.",
                "maxLength": 200,
                "minLength": 1,
                "type": "string",
              },
              "text": {
