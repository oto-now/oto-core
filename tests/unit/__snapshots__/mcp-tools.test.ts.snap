                "maxLength": 500,
                "minLength": 1,
                "type": "string",
              },
              "block": {
                "description": "Block operations: reference of the block, from read with refs: true or from find, e.g. "3f9a2c1b" or a key such as "etapes"; with replace_text, only in that block.",
                "maxLength": 500,
                "minLength": 1,
                "type": "string",
              },
              "count": {
                "description": "replace_text only: how many times find appears; all are replaced, and another number found is refused (default 1).",
